3. algorithms/route_optimizer.py

This uses the Nearest Neighbor Greedy Algorithm.

import math


def distance(a, b):

    return math.sqrt(
        (a["x"] - b["x"]) ** 2 +
        (a["y"] - b["y"]) ** 2
    )


def nearest_neighbor_route(locations):

    if not locations:
        return {
            "route": [],
            "total_distance": 0
        }

    unvisited = locations.copy()

    current = unvisited.pop(0)

    route = [current["name"]]

    total_distance = 0

    while unvisited:

        nearest = min(
            unvisited,
            key=lambda location: distance(current, location)
        )

        total_distance += distance(current, nearest)

        current = nearest

        route.append(current["name"])

        unvisited.remove(current)

    return {
        "route": route,
        "total_distance": round(total_distance, 2)
    }
4. algorithms/vehicle_allocator.py

This uses a Greedy Allocation Algorithm.

def allocate_vehicles(vehicles, cargo):

    if not vehicles:
        return {
            "allocations": [],
            "unallocated_cargo": len(cargo)
        }

    sorted_vehicles = sorted(
        vehicles,
        key=lambda x: x["capacity"],
        reverse=True
    )

    sorted_cargo = sorted(
        cargo,
        key=lambda x: x["weight"],
        reverse=True
    )

    allocations = []

    remaining_cargo = []

    for item in sorted_cargo:

        allocated = False

        for vehicle in sorted_vehicles:

            if vehicle["capacity"] >= item["weight"]:

                allocations.append({
                    "cargo": item["name"],
                    "vehicle": vehicle["name"],
                    "weight": item["weight"]
                })

                vehicle["capacity"] -= item["weight"]

                allocated = True

                break

        if not allocated:
            remaining_cargo.append(item["name"])

    return {
        "allocations": allocations,
        "unallocated_cargo": remaining_cargo
    }
5. algorithms/cargo_optimizer.py

This uses Dynamic Programming – 0/1 Knapsack Algorithm.

def knapsack_optimization(cargo, capacity):

    n = len(cargo)

    if n == 0:
        return {
            "selected_cargo": [],
            "maximum_value": 0,
            "total_weight": 0
        }

    dp = [[0 for _ in range(capacity + 1)]
          for _ in range(n + 1)]

    for i in range(1, n + 1):

        weight = int(cargo[i - 1]["weight"])
        value = int(cargo[i - 1]["priority"])

        for w in range(capacity + 1):

            if weight <= w:

                dp[i][w] = max(
                    value + dp[i - 1][w - weight],
                    dp[i - 1][w]
                )

            else:
                dp[i][w] = dp[i - 1][w]

    selected = []

    w = capacity

    for i in range(n, 0, -1):

        if dp[i][w] != dp[i - 1][w]:

            selected.append(cargo[i - 1])

            w -= int(cargo[i - 1]["weight"])

    selected.reverse()

    total_weight = sum(item["weight"] for item in selected)

    return {
        "selected_cargo": [item["name"] for item in selected],
        "maximum_value": dp[n][capacity],
        "total_weight": total_weight
    }
6. algorithms/scheduler.py

Priority-based scheduling using sorting.

def priority_schedule(cargo):

    sorted_cargo = sorted(
        cargo,
        key=lambda x: x["priority"],
        reverse=True
    )

    schedule = []

    position = 1

    for item in sorted_cargo:

        schedule.append({
            "order": position,
            "cargo": item["name"],
            "priority": item["priority"]
        })

        position += 1

    return schedule
