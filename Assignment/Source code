from flask import Flask, render_template, request, jsonify
from algorithms.route_optimizer import nearest_neighbor_route
from algorithms.vehicle_allocator import allocate_vehicles
from algorithms.cargo_optimizer import knapsack_optimization
from algorithms.scheduler import priority_schedule
import time

app = Flask(__name__)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/optimize", methods=["POST"])
def optimize():

    data = request.get_json()

    locations = data.get("locations", [])
    vehicles = data.get("vehicles", [])
    cargo = data.get("cargo", [])
    capacity = data.get("capacity", 100)

    start_time = time.time()

    # Route Optimization
    route_result = nearest_neighbor_route(locations)

    # Vehicle Allocation
    vehicle_result = allocate_vehicles(vehicles, cargo)

    # Cargo Optimization
    cargo_result = knapsack_optimization(cargo, capacity)

    # Delivery Scheduling
    schedule_result = priority_schedule(cargo)

    end_time = time.time()

    execution_time = round((end_time - start_time) * 1000, 4)

    return jsonify({
        "route": route_result,
        "vehicle_allocation": vehicle_result,
        "cargo_optimization": cargo_result,
        "schedule": schedule_result,
        "execution_time_ms": execution_time
    })


if __name__ == "__main__":
    app.run(debug=True)
