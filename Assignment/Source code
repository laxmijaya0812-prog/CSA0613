async function runOptimization() {

    const data = {

        locations: [
            { name: "Warehouse", x: 0, y: 0 },
            { name: "Chennai", x: 4, y: 7 },
            { name: "Bangalore", x: 10, y: 5 },
            { name: "Hyderabad", x: 14, y: 10 },
            { name: "Coimbatore", x: 6, y: 2 }
        ],

        vehicles: [
            { name: "Truck-1", capacity: 100 },
            { name: "Truck-2", capacity: 80 },
            { name: "Truck-3", capacity: 60 }
        ],

        cargo: [
            {
                name: "Medical Supplies",
                weight: 30,
                priority: 10
            },

            {
                name: "Electronics",
                weight: 40,
                priority: 8
            },

            {
                name: "Food Products",
                weight: 20,
                priority: 9
            },

            {
                name: "Industrial Parts",
                weight: 50,
                priority: 6
            },

            {
                name: "Emergency Equipment",
                weight: 25,
                priority: 10
            }
        ],

        capacity: 100
    };


    document.getElementById("route").innerHTML =
        "Processing...";

    try {

        const response = await fetch("/optimize", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify(data)

        });


        const result = await response.json();


        displayResults(result);

    }

    catch (error) {

        console.error(error);

        alert("Optimization failed");

    }

}


function displayResults(result) {


    document.getElementById("route").innerHTML = `

        <div class="result-item">

            <strong>Route:</strong>
            ${result.route.route.join(" → ")}

        </div>

        <div class="result-item">

            <strong>Total Distance:</strong>
            ${result.route.total_distance}

        </div>

    `;


    let vehicleHTML = "";

    result.vehicle_allocation.allocations.forEach(item => {

        vehicleHTML += `

            <div class="result-item">

                ${item.cargo}
                →
                ${item.vehicle}

                (${item.weight} kg)

            </div>

        `;

    });


    document.getElementById("vehicles").innerHTML =
        vehicleHTML;


    document.getElementById("cargo").innerHTML = `

        <div class="result-item">

            <strong>Selected Cargo:</strong>

            ${result.cargo_optimization.selected_cargo.join(", ")}

        </div>

        <div class="result-item">

            <strong>Maximum Priority Value:</strong>

            ${result.cargo_optimization.maximum_value}

        </div>

        <div class="result-item">

            <strong>Total Weight:</strong>

            ${result.cargo_optimization.total_weight} kg

        </div>

    `;


    let scheduleHTML = "";

    result.schedule.forEach(item => {

        scheduleHTML += `

            <div class="result-item">

                ${item.order}.
                ${item.cargo}

                (Priority: ${item.priority})

            </div>

        `;

    });


    document.getElementById("schedule").innerHTML =
        scheduleHTML;


    document.getElementById("performance").innerHTML = `

        <div class="result-item">

            <strong>Execution Time:</strong>

            ${result.execution_time_ms} ms

        </div>

        <div class="result-item">

            Algorithms Used:

            <ul>

                <li>Greedy Algorithm</li>

                <li>Nearest Neighbor</li>

                <li>Dynamic Programming</li>

                <li>Priority Scheduling</li>

            </ul>

        </div>

    `;

}
